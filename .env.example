# Copy to .env and adjust. Never commit real secrets.

# --- Database ------------------------------------------------------------
# Port the dev database (docker-compose.dev.yml) is published on. Docker
# Compose reads this file too, so the container and the URLs below stay in
# agreement. Change it when another Postgres already holds 5432 on your
# machine, for example Haij's dev database, and change the three URLs to
# match. 5438 is Kadence's own on a machine that also runs Haij (5432),
# Tavle (5433), Domino (5434), Makker (5435), Plot (5436) and Kladde (5437).
POSTGRES_PORT=5438
# Superuser/DDL connection, used only by migrations (pnpm db:migrate).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5438/kadence
# Application role: all domain queries, fully subject to RLS.
APP_DATABASE_URL=postgres://kadence_app:kadence_app@localhost:5438/kadence
# Better Auth role: auth and admission tables only.
AUTH_DATABASE_URL=postgres://kadence_auth:kadence_auth@localhost:5438/kadence

# --- Better Auth ---------------------------------------------------------
# Dev-only default so the quickstart works out of the box.
# In production ALWAYS generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# Public base URL of the app (passkeys bind to this origin).
BETTER_AUTH_URL=http://localhost:3000
# Other addresses the browser may sign in from, comma-separated - your
# machine's network name while developing, for example. Any origin not
# listed here or above is refused, and the login page says so. A demo
# opened from one of them lands back on it.
# AUTH_TRUSTED_ORIGINS=http://my-mac:3000,http://100.64.0.10:3000
# Development only: other hostnames `next dev` may serve its assets to,
# comma-separated - a Tailscale name to test from a phone, for example.
# KADENCE_DEV_HOSTS=my-mac.tailnet-name.ts.net,100.64.0.10

# --- Registration --------------------------------------------------------
# Who may create an account. "closed" (the default) admits the very first
# user on an empty installation and nobody after that; everyone else applies
# for access and the installation's owner admits them with an invitation
# link. "open" lets anyone register, which is for a demo instance, not for
# an organisation's own Kadence.
SIGNUP=closed

# --- Demo ----------------------------------------------------------------
# "on" gives every visitor to /demo their own workspace, thrown away
# after 24 hours. Off by default: an installation
# running real work should not hand out accounts. While this is "off" the
# /demo route answers 404.
DEMO=off

# --- AI ------------------------------------------------------------------
# LLM adapter: "mistral" (EU-hosted API), "ollama" (local or self-hosted,
# Ollama-compatible) or "none". Kadence is a chat: with "none" conversations
# can still be read, exported and the library edited, but the writing
# field says there is nothing to answer. The Mistral key is a
# secret: it lives only here locally and in Coolify in production - never
# in the repo. What is set here is the default every workspace inherits; a
# workspace can choose its own provider, model and key in Settings -> AI.
# OLLAMA_BASE_URL is deliberately not something a workspace can set.
LLM_PROVIDER=none
# MISTRAL_API_KEY=
# LLM_MODEL=mistral-small-latest
# OLLAMA_BASE_URL=http://localhost:11434
# Which Mistral endpoint to call. The default is the EU one, and that is
# the one docs/subprocessors.md and dogma four commit a hosted Kadence to:
# Mistral does not promise any particular inference location for the
# plain api.mistral.ai, and the regional endpoints cost 1.1x for the
# promise. Change this only if you know why you are doing it.
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
# The installation's own roof over model calls, counted across every
# workspace in a rolling 24 hours (docs/adr/0035). The per-user and
# per-workspace ceilings sit under it and are about a page in a loop;
# this one is about spend, which is why it is the installation's to set.
# 0 takes the roof off entirely - the honest setting when the model is
# Ollama on your own machine and a call costs nothing but your evening.
# AI_DAILY_CALL_CAP=2000

# --- Wahoo, Garmin and Polar --------------------------------------------
# Optional. With these set, a rider can connect their own Wahoo, Garmin or
# Polar account under Settings -> Devices: rides come in by themselves,
# and a coach can send a planned bike session to a Wahoo or Garmin head
# unit (not to Polar). Without them the settings page says so, and FIT
# upload, the calendar and everything else work exactly as before
# (dogma 2). Step by step: docs/devices-setup.md.
#
# Wahoo and Garmin are US companies, outside dogma four's EU rule; Polar is
# Finnish. Either way this is the rider's choice and never the team's:
# nothing is sent to a provider until a rider connects, and then only what
# docs/subprocessors.md lists. A self-hosted Kadence without these keys
# talks to none of them.
#
# Register an application with each provider and set its redirect URI to
#   <BETTER_AUTH_URL>/api/devices/wahoo/callback
#   <BETTER_AUTH_URL>/api/devices/garmin/callback
#   <BETTER_AUTH_URL>/api/devices/polar/callback
# and its webhook (Garmin: the Activity Files ping and deregistrations;
# Polar: EXERCISE, created through AccessLink's API) to
#   <BETTER_AUTH_URL>/api/devices/wahoo/webhook
#   <BETTER_AUTH_URL>/api/devices/garmin/webhook
#   <BETTER_AUTH_URL>/api/devices/polar/webhook
# Webhooks need that address to be public https: see docs/devices-setup.md.
# A provider's client id and secret come as a pair or not at all.
# WAHOO_CLIENT_ID=
# WAHOO_CLIENT_SECRET=
# The webhook token you set in Wahoo's developer portal, at least 16
# characters (openssl rand -hex 24). Wahoo echoes it in every webhook; a
# webhook without it is refused, and without this variable every one is.
# WAHOO_WEBHOOK_TOKEN=
# Garmin's Connect Developer Program (OAuth 2.0 with PKCE). Onboarding was
# paused in 2026; the adapter is complete and waits for keys.
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=
# Polar's AccessLink (admin.polaraccesslink.com; OAuth 2.0 without PKCE).
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# The signature_secret_key AccessLink returns once, when the webhook is
# created (docs/devices-setup.md). Every Polar notification is signed with
# it; without this variable every one is refused.
# POLAR_WEBHOOK_SECRET=

# --- The map behind a ride's route ----------------------------------------
# A PMTiles file of OpenStreetMap data on this server, served by Kadence
# itself: no position leaves the installation. `scripts/fetch-map.sh`
# fetches Denmark (a few hundred MB). Without it the route is drawn alone.
# MAP_FILE=./data/map/denmark.pmtiles

# --- Behind a proxy ------------------------------------------------------
# How many proxies in front of Kadence append to X-Forwarded-For. Rate limits
# read the address that many entries from the END of that header, because
# everything to the left of your own proxy's entry was written by the
# caller. 1 is right for the Coolify/Traefik deployment in docs/deploy.md.
# Set 0 only when nothing at all sits in front.
# TRUSTED_PROXY_HOPS=1

# --- Production only (docker-compose.yml) --------------------------------
# The production stack refuses to start without these; there are no
# defaults on purpose. Generate every one of them fresh, on your own
# machine, for this installation - never reuse another installation's:
#   openssl rand -hex 24
# Hex rather than base64: these three are pasted into
# postgres://user:PASSWORD@db:5432/kadence, and a "/" from base64 would end
# the URL there. BETTER_AUTH_SECRET never goes into a URL and stays base64.
# See docs/deploy.md.
# POSTGRES_PASSWORD=
# KADENCE_APP_PASSWORD=
# KADENCE_AUTH_PASSWORD=
